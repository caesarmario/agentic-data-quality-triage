####
## Environment Variables Example for Agentic Data Quality Triage
## Author: Mario Caesar // hello@caesarmar.io // https://caesarmar.io/
####

# --- Usage Note
# Copy this file to infra/.env before running Docker Compose.

# --- Defining Project Defaults
COMPOSE_PROJECT_NAME=agentic-dq-triage
COMPOSE_ANSI=never
COMPOSE_PROGRESS=plain
DOCKER_BUILDKIT=1
BUILDKIT_PROGRESS=plain
PYTHON_RUNNER_IMAGE=agentic-dq-python:local
CH_UI_IMAGE=ghcr.io/caioricciuti/ch-ui:v2.5.1
TZ=Asia/Bangkok

# --- Defining Host Ports
AIRFLOW_PORT=8080
FLOWER_PORT=5555
STREAMLIT_PORT=8501
API_PORT=8000
CH_HTTP_PORT=8123
CH_NATIVE_PORT=9000
CH_UI_PORT=3488
SEAWEED_MASTER_PORT=9333
SEAWEED_VOLUME_PORT=18080
SEAWEED_FILER_PORT=8888
SEAWEED_S3_PORT=8333
AIRFLOW_POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379

# --- Defining ClickHouse Settings
CLICKHOUSE_DB=dq
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CHUI_CLICKHOUSE_URL=http://clickhouse:8123
CHUI_CONNECTION_NAME=Local ClickHouse

# --- Defining SeaweedFS S3 Settings
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=admin
AWS_DEFAULT_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=true
S3_ENDPOINT_URL_INTERNAL=http://seaweed-s3:8333
S3_ENDPOINT_URL_EXTERNAL=http://localhost:8333
LANDING_BUCKET=dq-landing
ARTIFACTS_BUCKET=dq-artifacts
DQREPORTS_BUCKET=dq-dqreports
DQFAILURES_BUCKET=dq-dqfailures
AUDIT_BUCKET=dq-audit

# --- Defining Airflow Settings
AIRFLOW_VERSION=3.1.7
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__AUTH_MANAGER=airflow.api_fastapi.auth.managers.simple.simple_auth_manager.SimpleAuthManager
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__DEFAULT_TIMEZONE=Asia/Bangkok
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-api-server:8080/execution/
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=admin:admin
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_PASSWORDS_FILE=/opt/airflow/auth/simple_auth_manager_passwords.json
AIRFLOW__API_AUTH__JWT_SECRET=local-agentic-dq-triage-jwt-secret-change-me-64-bytes-minimum-demo-only
AIRFLOW__API_AUTH__JWT_ALGORITHM=HS512
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-postgres:5432/airflow
AIRFLOW__CELERY__BROKER_URL=redis://airflow-redis:6379/0
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:airflow@airflow-postgres:5432/airflow
AIRFLOW__CELERY__WORKER_CONCURRENCY=4
AIRFLOW__DAG_PROCESSOR__REFRESH_INTERVAL=30
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW_WWW_USER_EMAIL=admin@example.com
AIRFLOW_WWW_USER_FIRSTNAME=Airflow
AIRFLOW_WWW_USER_LASTNAME=Admin
AIRFLOW_PIP_ADDITIONAL_REQUIREMENTS=
DQ_RUNNER_CONTAINER=dq_runner
AIRFLOW_DOCKER_EXEC=/usr/bin/docker

# --- Defining LLM Provider Settings
# Do not commit real keys.
LLM_ROUTING_CONFIG_PATH=configs/agent/model_routing.yml
# External providers remain disabled until this explicit global switch is enabled.
EXTERNAL_LLM_ENABLED=false
LLM_PROVIDER_TIMEOUT_SECONDS=30
LLM_PROVIDER_MAX_RETRIES=0
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
XAI_BASE_URL=https://api.x.ai/v1
XAI_API_KEY=
XAI_MODEL=grok-4.6
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# --- Defining Optional LangGraph Checkpoint Settings
# Default off preserves the current stateless local behavior.
AGENT_CHECKPOINT_MODE=off
AGENT_CHECKPOINT_SQLITE_PATH=/var/lib/agent-checkpoints/triage.sqlite3
AGENT_CHECKPOINT_BUSY_TIMEOUT_MS=5000
# Keep checkpoint deserialization fail-closed. Project state classes use an explicit allowlist.
LANGGRAPH_STRICT_MSGPACK=true


# --- Defining Optional Control Plane API Settings
# Start the API profile before setting this URL inside Docker.
CONTROL_PLANE_API_URL=
COPILOT_API_TIMEOUT_SECONDS=15
# Required by approval create/decision endpoints. Use a long random local secret.
CONTROL_PLANE_APPROVAL_TOKEN=

# --- Defining Optional Discord Bot Settings
# The docker service is behind the "discord" profile and uses guild-scoped slash commands.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALERTS_CHANNEL_ID=
DISCORD_TRIAGE_CHANNEL_ID=
DISCORD_OPS_CHANNEL_ID=

# Optional one-way alert delivery used by Airflow after deterministic alert generation.
# Keep this secret blank when webhook delivery is not required.
DISCORD_ALERT_WEBHOOK_URL=
DISCORD_WEBHOOK_USERNAME=DataSentry
DISCORD_WEBHOOK_TIMEOUT_SECONDS=10
DISCORD_WEBHOOK_MAX_ALERTS=20
