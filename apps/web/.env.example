# Server-only URL for the existing FastAPI control plane.
CONTROL_PLANE_API_URL=http://localhost:8000

# Exact public browser origin used by Host and mutation-origin validation.
# Docker Compose supplies its own private API URL and matches WEB_PORT.
WEB_ORIGIN=http://localhost:3000

# Optional. Enables real approval API calls through the server-side proxy.
# Never expose this value with NEXT_PUBLIC_ prefix.
CONTROL_PLANE_APPROVAL_TOKEN=
