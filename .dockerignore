# --- Ignoring Git And IDE Metadata
.git
.github
.vscode

# --- Ignoring Local Runtime Outputs
data
logs
todo
output
.pytest_cache

# --- Ignoring Python Cache And Logs
**/__pycache__
**/*.pyc
**/*.pyo
**/*.log

# --- Ignoring Local Secrets
infra/.env
infra/airflow/auth

# --- Ignoring dbt Artifacts
warehouse/dbt/target
warehouse/dbt/dbt_packages

# --- Keeping Offline Media Tooling Out Of Runtime Build Contexts
tools/demo-video/node_modules
tools/demo-video/.cache
tools/demo-video/out
tools/demo-video/*.tsbuildinfo

